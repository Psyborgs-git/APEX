# Copy to .env and fill in the values you actually use.
# Leave unused brokers blank.
# Leave the Python path overrides blank to auto-detect `apex-python/.venv/bin/python`
# (or fall back to `python3` if no local virtualenv exists).

APEX_STRATEGY_PYTHON_PATH=
APEX_ML_PYTHON_PATH=
APEX_SIDECAR_SOCKET=/tmp/apex_strategy.sock
APEX_LOG_LEVEL=info

# Traditional brokers
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_REDIRECT_URL=http://localhost:3000/auth/zerodha/callback
ZERODHA_ACCESS_TOKEN=

ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_CODE=
ANGEL_ONE_JWT_TOKEN=

GROWW_API_KEY=
GROWW_ACCESS_TOKEN=

ROBINHOOD_CLIENT_ID=
ROBINHOOD_ACCESS_TOKEN=

# Crypto exchanges
BINANCE_API_KEY=
BINANCE_API_SECRET=

COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_PASSPHRASE=

# Infrastructure
APEX_POSTGRES_URL=postgresql://apex:apex_password@localhost:5433/apex_market
APEX_REDIS_URL=redis://localhost:6380
